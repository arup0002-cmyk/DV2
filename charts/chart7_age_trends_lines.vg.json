{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Overall Smartphone Activity Participation by Age Group",
    "subtitle": "Average participation across all activities (2015–2020)",
    "color": "#cbd5e1",
    "subtitleColor": "#94a3b8",
    "fontSize": 20
  },

  "width": 420,
  "height": 280,
  "background": "transparent",

  "data": {
    "values": [
      {"Age_Group":"6-9 year olds","Average":48},
      {"Age_Group":"10-11 year olds","Average":63},
      {"Age_Group":"12-13 year olds","Average":77}
    ]
  },

  "mark": {
    "type": "bar",
    "cornerRadiusTopLeft": 6,
    "cornerRadiusTopRight": 6
  },

  "encoding": {
    "x": {
      "field": "Age_Group",
      "type": "nominal",
      "sort": [
        "6-9 year olds",
        "10-11 year olds",
        "12-13 year olds"
      ],
      "title": "Age Group",
      "axis": {
        "labelColor": "#cbd5e1",
        "titleColor": "#cbd5e1"
      }
    },

    "y": {
      "field": "Average",
      "type": "quantitative",
      "title": "Average Participation (%)",
      "axis": {
        "labelColor": "#cbd5e1",
        "titleColor": "#cbd5e1",
        "gridColor": "#334155"
      }
    },

    "color": {
      "field": "Age_Group",
      "type": "nominal",
      "scale": {
        "range": [
          "#38bdf8",
          "#a78bfa",
          "#f472b6"
        ]
      },
      "legend": null
    },

    "tooltip": [
      {"field":"Age_Group"},
      {"field":"Average","format":".1f"}
    ]
  },

  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}
