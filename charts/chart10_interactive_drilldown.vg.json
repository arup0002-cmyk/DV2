{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Explore Activities by Age Group",
    "subtitle": "Explore how different age groups use smartphones",
    "color": "#cbd5e1",
    "subtitleColor": "#94a3b8",
    "fontSize": 18
  },

  "width": "container",
  "height": 300,
  "background": "transparent",

  "data": {
    "url": "datasets/reasons_for_internet_usage.csv"
  },

  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 4
  },

  "encoding": {
    "x": {
      "field": "2016-17_Pct",
      "type": "quantitative",
      "title": "Modern Adoption Level (%)",
      "axis": {
        "labelColor": "#94a3b8",
        "titleColor": "#94a3b8",
        "gridColor": "#334155"
      }
    },

    "y": {
      "field": "Reason",
      "type": "nominal",
      "title": null,
      "axis": {
        "labelColor": "#94a3b8"
      }
    },

    "color": {
      "field": "2016-17_Pct",
      "type": "quantitative",
      "scale": {
        "range": [
          "#38bdf8",
          "#60a5fa",
          "#a78bfa",
          "#f472b6"
        ]
      },
      "legend": null
    },

    "tooltip": [
      {
        "field": "Reason",
        "type": "nominal",
        "title": "Activity"
      },
      {
        "field": "2016-17_Pct",
        "type": "quantitative",
        "title": "Usage (%)",
        "format": ".1f"
      }
    ]
  },

  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}
