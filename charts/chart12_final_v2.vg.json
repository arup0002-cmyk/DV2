{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Most Popular Smartphone Activities",
    "subtitle": "Average participation rates (2015–2020)",
    "color": "#e2e8f0",
    "subtitleColor": "#94a3b8",
    "fontSize": 18,
    "anchor": "start"
  },
  "width": 1100,
  "height": 350,
  "background": "transparent",
  "data": {
    "values": [
      {"Activity": "Play games", "Average": 67},
      {"Activity": "Take photos/videos", "Average": 66},
      {"Activity": "Use apps", "Average": 61},
      {"Activity": "Send or receive texts", "Average": 56}
    ]
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 4,
        "color": "#64748b"
      },
      "encoding": {
        "y": {
          "field": "Activity",
          "type": "nominal",
          "sort": "-x",
          "axis": {
            "labelColor": "#e2e8f0",
            "labelFontSize": 14,
            "domain": false,
            "ticks": false,
            "title": null
          }
        },
        "x": {
          "value": 0
        },
        "x2": {
          "field": "Average"
        }
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 500,
        "color": "#38bdf8"
      },
      "encoding": {
        "y": {
          "field": "Activity",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Average",
          "type": "quantitative",
          "scale": {
            "domain": [0, 75]
          },
          "axis": {
            "title": "Participation Rate (%)",
            "labelColor": "#94a3b8",
            "titleColor": "#94a3b8",
            "gridColor": "#334155",
            "tickColor": "#334155"
          }
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 15,
        "fontSize": 14,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "y": {
          "field": "Activity",
          "type": "nominal",
          "sort": "-x"
        },
        "x": {
          "field": "Average",
          "type": "quantitative"
        },
        "text": {
          "field": "Average",
          "type": "quantitative",
          "format": ".0f"
        }
      }
    }
  ],
  "config": {
    "view": {
      "stroke": null
    }
  }
}
