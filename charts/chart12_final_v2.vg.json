{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "background": "#1e2d46",

  "width": 1050,
  "height": 240,

  "padding": {
    "left": 20,
    "right": 50,
    "top": 20,
    "bottom": 20
  },

  "title": {
    "text": "Most Popular Smartphone Activities",
    "subtitle": "Average participation rates (2015–2020)",
    "fontSize": 24,
    "fontWeight": "bold",
    "color": "#e2e8f0",
    "subtitleFontSize": 15,
    "subtitleColor": "#94a3b8",
    "anchor": "start"
  },

  "data": {
    "values": [
      {"Activity": "Play games", "Average": 67},
      {"Activity": "Take photos/videos", "Average": 66},
      {"Activity": "Use apps", "Average": 61},
      {"Activity": "Send or receive texts", "Average": 56}
    ]
  },

  "encoding": {
    "y": {
      "field": "Activity",
      "type": "nominal",
      "sort": "-x",
      "title": null,
      "axis": {
        "labelColor": "#e2e8f0",
        "labelFontSize": 16,
        "labelPadding": 10,
        "domain": false,
        "ticks": false
      }
    },

    "x": {
      "field": "Average",
      "type": "quantitative",
      "scale": {
        "domain": [0, 75]
      },
      "title": "Participation Rate (%)",
      "axis": {
        "labelColor": "#94a3b8",
        "titleColor": "#cbd5e1",
        "titleFontSize": 15,
        "labelFontSize": 13,
        "gridColor": "#334155",
        "tickColor": "#475569",
        "domainColor": "#475569"
      }
    }
  },

  "layer": [
    {
      "mark": {
        "type": "bar",
        "size": 4,
        "color": "#64748b"
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 450,
        "color": "#4cc9ff"
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 14,
        "fontSize": 16,
        "fontWeight": "bold",
        "color": "#ffffff"
      },

      "encoding": {
        "text": {
          "field": "Average"
        }
      }
    }
  ],

  "config": {
    "view": {
      "stroke": null
    }
  }
}
