{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "width": 900,
  "height": 250,
  "background": "transparent",

  "data": {
    "values": [
      {"Activity":"Play games","Average":67},
      {"Activity":"Take photos/videos","Average":66},
      {"Activity":"Use apps","Average":61},
      {"Activity":"Send or receive texts","Average":56}
    ]
  },

  "mark": {
    "type": "bar",
    "color": "#38bdf8"
  },

  "encoding": {
    "y": {
      "field": "Activity",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "title": null,
        "labelColor": "#cbd5e1",
        "domain": false,
        "ticks": false
      }
    },

    "x": {
      "field": "Average",
      "type": "quantitative",
      "title": "Participation Rate (%)",
      "axis": {
        "labelColor": "#cbd5e1",
        "titleColor": "#cbd5e1",
        "gridColor": "#cbd5e1",
        "domainColor": "#cbd5e1",
        "tickColor": "#cbd5e1"
      }
    }
  },

  "config": {
    "view": {
      "stroke": null
    }
  }
}
