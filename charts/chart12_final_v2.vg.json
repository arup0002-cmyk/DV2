{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Most Popular Smartphone Activities",
    "subtitle": "Average participation rates (2015–2020)",
    "color": "#e2e8f0",
    "subtitleColor": "#94a3b8",
    "fontSize": 16,
    "anchor": "start",
    "offset": 20
  },
  "width": 450,
  "height": 200,
  "background": "transparent",
  "data": {
    "values": [
      {"Activity": "Play games", "Average": 67},
      {"Activity": "Take photos/videos", "Average": 66},
      {"Activity": "Use apps", "Average": 61},
      {"Activity": "Send or receive texts", "Average": 56}
    ]
  },
  "layer": [
    {
      "mark": {"type": "rule", "strokeWidth": 2, "color": "#475569"},
      "encoding": {
        "y": {"field": "Activity", "type": "nominal", "sort": "-x", "title": null, "axis": {"labelColor": "#cbd5e1", "labelFontSize": 12, "domain": false, "ticks": false}},
        "x": {"value": 0},
        "x2": {"field": "Average"}
      }
    },
    {
      "mark": {"type": "circle", "size": 300, "color": "#38bdf8"},
      "encoding": {
        "y": {"field": "Activity", "type": "nominal", "sort": "-x"},
        "x": {"field": "Average", "type": "quantitative", "title": "Participation Rate (%)", "axis": {"labelColor": "#94a3b8", "titleColor": "#94a3b8", "gridColor": "#334155", "tickColor": "#334155"}}
      }
    },
    {
      "mark": {"type": "text", "align": "left", "baseline": "middle", "dx": 15, "fontSize": 12, "color": "#ffffff", "fontWeight": "600"},
      "encoding": {
        "y": {"field": "Activity", "type": "nominal", "sort": "-x"},
        "x": {"field": "Average", "type": "quantitative"},
        "text": {"field": "Average", "type": "quantitative"}
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"}
  }
}
