{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Digital Maturity Ranking by State",
    "subtitle": "Average smartphone activity participation among children (2020)",
    "color": "#cbd5e1",
    "subtitleColor": "#94a3b8",
    "fontSize": 18
  },

  "width": 420,
  "height": 260,
  "background": "transparent",

  "data": {
    "values": [
      {"State":"WA","Score":64},
      {"State":"Vic/Tas","Score":63},
      {"State":"SA/NT","Score":62},
      {"State":"NSW/ACT","Score":61},
      {"State":"Qld","Score":59}
    ]
  },

  "mark": {
    "type":"bar",
    "cornerRadiusEnd":8
  },

  "encoding": {
    "y": {
      "field":"State",
      "type":"nominal",
      "sort":"-x",
      "title":null,
      "axis":{
        "labelColor":"#cbd5e1"
      }
    },

    "x": {
      "field":"Score",
      "type":"quantitative",
      "title":"Digital Engagement Score (%)",
      "axis":{
        "labelColor":"#cbd5e1",
        "titleColor":"#cbd5e1",
        "gridColor":"#334155"
      }
    },

    "color": {
      "field":"Score",
      "type":"quantitative",
      "scale":{
        "range":["#38bdf8","#a78bfa","#f472b6"]
      },
      "legend":null
    },

    "tooltip":[
      {"field":"State"},
      {"field":"Score"}
    ]
  },

  "config":{
    "view":{
      "stroke":"transparent"
    }
  }
}
