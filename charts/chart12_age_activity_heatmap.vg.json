{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Most Popular Smartphone Activities Among Children",
    "subtitle": "Average participation rates across all age groups (2015–2020)",
    "color": "#cbd5e1",
    "subtitleColor": "#94a3b8"
  },

  "width": 500,
  "height": 250,
  "background": "transparent",

  "data": {
    "values": [
      {"Activity":"Play games","Average":67},
      {"Activity":"Take photos/videos","Average":66},
      {"Activity":"Use apps","Average":61},
      {"Activity":"Send or receive texts","Average":56}
    ]
  },

  "mark": {
    "type": "circle",
    "size": 500
  },

  "encoding": {
    "x": {
      "field": "Average",
      "type": "quantitative",
      "title": "Participation (%)"
    },

    "y": {
      "field": "Activity",
      "type": "nominal",
      "sort": "-x"
    },

    "color": {
      "field": "Average",
      "type": "quantitative",
      "scale": {
        "scheme": "blues"
      }
    }
  },

  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}
