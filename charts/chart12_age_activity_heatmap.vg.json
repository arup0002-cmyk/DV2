{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Most Popular Smartphone Activities Among Children",
    "subtitle": "Average participation rates across all age groups (2015–2020)",
    "color": "#cbd5e1",
    "subtitleColor": "#94a3b8",
    "fontSize": 18
  },

  "width": 600,
  "height": 320,
  "background": "transparent",

  "data": {
    "values": [
      {"Activity":"Send or receive texts","Average":56},
      {"Activity":"Take photos/videos","Average":66},
      {"Activity":"Use apps","Average":61},
      {"Activity":"Play games","Average":67}
    ]
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#475569",
        "strokeWidth": 3
      },
      "encoding": {
        "y": {
          "field": "Activity",
          "type": "nominal",
          "sort": "-x",
          "title": null,
          "axis": {
            "labelColor": "#94a3b8"
          }
        },
        "x": {
          "value": 0
        },
        "x2": {
          "field": "Average"
        }
      }
    },

    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 220
      },
      "encoding": {
        "y": {
          "field": "Activity",
          "type": "nominal",
          "sort": "-x"
        },

        "x": {
          "field": "Average",
          "type": "quantitative",
          "title": "Average Participation (%)",
          "axis": {
            "labelColor": "#94a3b8",
            "titleColor": "#94a3b8",
            "gridColor": "#334155"
          }
        },

        "color": {
          "field": "Average",
          "type": "quantitative",
          "scale": {
            "range": [
              "#93c5fd",
              "#60a5fa",
              "#3b82f6",
              "#1d4ed8"
            ]
          },
          "legend": null
        },

        "tooltip": [
          {"field":"Activity"},
          {"field":"Average","title":"Participation (%)"}
        ]
      }
    }
  ],

  "config": {
    "view": {
      "stroke": "transparent"
    }
  }
}
